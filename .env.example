# ============================================================
#  Shorts Automation Pipeline - 환경변수 템플릿
# ============================================================
#
#  이 파일을 .env 로 복사한 뒤 각 키를 실제 발급받은 값으로 채워주세요.
#
#  Windows PowerShell:
#    copy .env.example .env
#
#  ⚠️ .env 파일은 절대 GitHub에 올리지 마세요. (.gitignore에 포함되어 있음)
#  ⚠️ 키를 SNS, 블로그, 채팅에 노출하지 마세요.
#
# ============================================================

# ----- Anthropic Claude (필수) -----
# 발급: https://console.anthropic.com → API Keys → Create Key
# 형식: sk-ant-...
ANTHROPIC_API_KEY=

# ----- ElevenLabs TTS (필수) -----
# 발급: https://elevenlabs.io → 프로필 → API Keys
# 형식: sk_...
ELEVENLABS_API_KEY=

# 자주 쓸 음성 ID (선택, 비워두면 기본값 사용)
# 한국어 음성 ID는 ElevenLabs Voice Library에서 검색
ELEVENLABS_VOICE_ID_DEFAULT=

# ----- OpenAI (선택) -----
# Higgsfield 외에 GPT Image도 쓰고 싶을 때만
# 발급: https://platform.openai.com → API keys
OPENAI_API_KEY=

# ----- Google Gemini (선택) -----
# Higgsfield 외에 직접 Gemini 이미지를 호출하고 싶을 때만
# 발급: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=

# ============================================================
#  주의:
#  - Higgsfield는 별도 API 키가 아니라 Claude Code의 MCP 연결로 사용합니다.
#    Claude Code 안에서 /mcp 명령으로 연결하세요.
#  - 값 앞뒤에 따옴표나 공백을 넣지 마세요.
#  - =(등호) 앞뒤에도 공백이 없어야 합니다.
# ============================================================
